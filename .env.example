# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GKE_CLUSTER=your-gke-cluster-name
GKE_REGION=us-central1
GAR_REPOSITORY=your-artifact-registry-repo

# Application
APP_NAMESPACE=your-app-namespace
STATIC_IP_NAME=your-static-ip-name
API_DOMAIN=api.your-domain.com
APP_DOMAIN=app.your-domain.com

# Turbo (optional - for monorepo build caching)
TURBO_TOKEN=your-turbo-token
TURBO_TEAM=your-turbo-team
